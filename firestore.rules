rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGameId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidBoundedIdList(listVal, maxCount) {
      return listVal is list &&
        listVal.size() <= maxCount &&
        (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 64));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'title', 'xp', 'level', 'coins', 'streakDays',
          'avatarSuitColor', 'avatarAccentColor', 'avatarVisorStyle', 'avatarPackStyle',
          'visitedDistricts', 'claimedMissions', 'unlockedAchievements',
          'gamesCompletedCount', 'qualityTier', 'soundEnabled', 'cameraSensitivity', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'title', 'xp', 'level', 'coins', 'streakDays',
          'avatarSuitColor', 'avatarAccentColor', 'avatarVisorStyle', 'avatarPackStyle',
          'visitedDistricts', 'claimedMissions', 'unlockedAchievements',
          'gamesCompletedCount', 'qualityTier', 'soundEnabled', 'cameraSensitivity', 'updatedAt'
        ]) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 48 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 48 &&
        data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
        data.level is int && data.level >= 1 && data.level <= 500 &&
        data.coins is int && data.coins >= 0 && data.coins <= 10000000 &&
        data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
        isValidHexColor(data.avatarSuitColor) &&
        isValidHexColor(data.avatarAccentColor) &&
        data.avatarVisorStyle in ['sky', 'amber', 'emerald', 'obsidian'] &&
        data.avatarPackStyle in ['wings', 'thruster', 'satchel', 'none'] &&
        isValidBoundedIdList(data.visitedDistricts, 10) &&
        isValidBoundedIdList(data.claimedMissions, 30) &&
        isValidBoundedIdList(data.unlockedAchievements, 30) &&
        data.gamesCompletedCount is int && data.gamesCompletedCount >= 0 && data.gamesCompletedCount <= 20 &&
        data.qualityTier in ['auto', 'low', 'high'] &&
        data.soundEnabled is bool &&
        data.cameraSensitivity is number && data.cameraSensitivity >= 0.2 && data.cameraSensitivity <= 3.0 &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    function isValidGameProgress(data, userId, gameId) {
      return data.keys().hasAll(['uid', 'gameId', 'bestScore', 'bestAccuracy', 'playCount', 'highestDifficulty', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'gameId', 'bestScore', 'bestAccuracy', 'playCount', 'highestDifficulty', 'updatedAt']) &&
        data.uid == userId &&
        data.gameId == gameId &&
        isValidId(data.uid) &&
        isValidGameId(data.gameId) &&
        data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000 &&
        data.bestAccuracy is int && data.bestAccuracy >= 0 && data.bestAccuracy <= 100 &&
        data.playCount is int && data.playCount >= 1 && data.playCount <= 100000 &&
        data.highestDifficulty in ['explorer', 'scholar', 'master'] &&
        data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'title', 'xp', 'level', 'gamesCompletedCount', 'avatarAccentColor', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'title', 'xp', 'level', 'gamesCompletedCount', 'avatarAccentColor', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 48 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 48 &&
        data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
        data.level is int && data.level >= 1 && data.level <= 500 &&
        data.gamesCompletedCount is int && data.gamesCompletedCount >= 0 && data.gamesCompletedCount <= 20 &&
        isValidHexColor(data.avatarAccentColor) &&
        data.updatedAt is timestamp;
    }

    function isValidSandboxBuild(data, userId, buildId) {
      return data.keys().hasAll(['uid', 'buildId', 'name', 'zoneId', 'itemCount', 'items', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'buildId', 'name', 'zoneId', 'itemCount', 'items', 'updatedAt']) &&
        data.uid == userId &&
        data.buildId == buildId &&
        isValidId(data.uid) &&
        isValidId(data.buildId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
        data.zoneId is string && data.zoneId.size() >= 1 && data.zoneId.size() <= 48 &&
        data.itemCount is int && data.itemCount >= 0 && data.itemCount <= 250 &&
        data.items is list && data.items.size() <= 250 &&
        data.items.size() == data.itemCount &&
        (data.items.size() == 0 || (
          data.items[0] is map &&
          data.items[0].keys().hasAll(['id', 'itemId', 'x', 'y', 'z', 'rotY']) &&
          data.items[0].keys().hasOnly(['id', 'itemId', 'x', 'y', 'z', 'rotY', 'materialVariant']) &&
          data.items[0].id is string && data.items[0].id.size() <= 64 &&
          data.items[0].itemId is string && data.items[0].itemId.size() <= 48 &&
          data.items[0].x is number && data.items[0].y is number && data.items[0].z is number && data.items[0].rotY is number
        )) &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'xp', 'level', 'coins', 'streakDays', 'title',
            'visitedDistricts', 'claimedMissions', 'unlockedAchievements',
            'gamesCompletedCount', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'avatarSuitColor', 'avatarAccentColor',
            'avatarVisorStyle', 'avatarPackStyle', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'qualityTier', 'soundEnabled', 'cameraSensitivity', 'updatedAt'
          ])
        );
      allow delete: if false;

      match /private/info {
        allow get: if isValidId(userId) && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      match /gameProgress/{gameId} {
        allow get: if isValidId(userId) && isValidGameId(gameId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidGameId(gameId) &&
          isOwner(userId) &&
          isValidGameProgress(incoming(), userId, gameId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) &&
          isValidGameId(gameId) &&
          isOwner(userId) &&
          isValidGameProgress(incoming(), userId, gameId) &&
          incoming().uid == existing().uid &&
          incoming().gameId == existing().gameId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'bestScore', 'bestAccuracy', 'playCount', 'highestDifficulty', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /sandboxBuilds/{buildId} {
        allow get: if isValidId(userId) && isValidId(buildId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(buildId) &&
          isOwner(userId) &&
          isValidSandboxBuild(incoming(), userId, buildId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) &&
          isValidId(buildId) &&
          isOwner(userId) &&
          isValidSandboxBuild(incoming(), userId, buildId) &&
          incoming().uid == existing().uid &&
          incoming().buildId == existing().buildId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'zoneId', 'itemCount', 'items', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(buildId) && isOwner(userId);
      }
    }

    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.xp >= 0;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'title', 'xp', 'level', 'gamesCompletedCount', 'avatarAccentColor', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
